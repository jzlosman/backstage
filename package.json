{
  "name": "backstage",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "format": "cargo fmt --all -- --check && pnpm --dir frontend format:check",
    "format:write": "cargo fmt --all && pnpm --dir frontend format",
    "lint": "cargo clippy --workspace --all-targets --all-features -- -D warnings && bash scripts/check-core-boundary.sh && pnpm --dir frontend lint",
    "test": "cargo test --workspace && pnpm --dir frontend test",
    "typecheck": "pnpm --dir frontend typecheck",
    "build": "cargo build --workspace && pnpm --dir frontend build",
    "build:release": "pnpm --dir frontend build && cargo build --workspace --release",
    "check:release-config": "bash scripts/check-release-config.sh",
    "tauri": "pnpm exec tauri"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.3.1",
    "@tauri-apps/cli": "^2.8.5"
  }
}
